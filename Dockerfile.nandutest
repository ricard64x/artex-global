# Independent build of this fork. Do not confuse with the pinned upstream
# production image in fly.toml.
FROM node:22-bookworm-slim AS webbuild
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build:static

FROM golang:1.26-bookworm AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=webbuild /src/web/out/ ./server/webui/dist/
RUN CGO_ENABLED=0 GOOS=linux go build -tags embedui -trimpath \
  -ldflags "-s -w -buildid= -X main.version=nandutest-pilot" \
  -o /out/artex ./cmd/artex

# Preserve the original runtime tools (Node/Playwright, nmap, DNS and browser
# tooling) while replacing the application binary with our audited fork.
FROM ghcr.io/jiwoochris/artex-global:v0.3.15-global.1
RUN apt-get update \
  && sed -i 's/Components: main/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends gosu nikto whatweb sslscan gobuster ffuf chromium \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin artex
WORKDIR /app
COPY --from=gobuild --chown=10001:10001 /out/artex /app/artex
COPY --chown=10001:10001 start.sh /app/start.sh
COPY --chown=10001:10001 skills/ /app/skills/
# Install browser automation dependencies once at image build, not per task.
# The worker runs a task-specific copy; Node resolves the locked dependencies.
RUN npm ci --ignore-scripts --omit=dev --prefix /app/skills/api-recon/scripts \
  && test -x /usr/bin/chromium \
  && NODE_PATH=/app/skills/api-recon/scripts/node_modules node -e 'require("puppeteer-core")'
ENV CHROMIUM=/usr/bin/chromium
ENV NODE_PATH=/app/skills/api-recon/scripts/node_modules
COPY --chown=0:0 scripts/nandutest_pilot_lab.py /usr/local/lib/nandutest/pilot_lab.py
COPY --chown=10001:10001 scripts/nandutest_model_preflight.py /app/scripts/nandutest_model_preflight.py
COPY --chown=10001:10001 scripts/nandutest_metrics.py /app/scripts/nandutest_metrics.py
# Fail the image build if the isolated eight-phase control-plane canary fails.
RUN chmod 0444 /usr/local/lib/nandutest/pilot_lab.py \
  && gosu artex python3 /usr/local/lib/nandutest/pilot_lab.py --authorize-lab > /tmp/nandutest_lab_smoke.json \
  && rm -f /tmp/nandutest_lab_smoke.json
RUN chmod +x /app/start.sh /app/artex \
  && mkdir -p /app/data \
  && chown -R 10001:10001 /app \
  && chmod -R a-w /app/skills/api-recon \
  && gosu artex node /app/skills/api-recon/scripts/browser_smoke.js
COPY scripts/nandutest-entrypoint.sh /app/nandutest-entrypoint.sh
RUN chmod +x /app/nandutest-entrypoint.sh
ENV ARTEX_LANG=es
EXPOSE 8787
ENTRYPOINT ["/app/nandutest-entrypoint.sh"]
CMD ["-addr",":8787","-proxy","127.0.0.1:8788"]
